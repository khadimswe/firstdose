# Copy to .env and fill in. Never commit .env.

# data source for every screen: mock | supabase
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (Vihn)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tiger Data (plain pg driver) (Vihn)
TIGER_DATABASE_URL=

# Gemini API: note text -> reason enum only (Vihn)
GEMINI_API_KEY=

# xAI Grok STT (Vihn)
XAI_API_KEY=

# ElevenLabs (MLH code)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ntfy topic that the iPhone app subscribes to (Vihn)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# OpenAI via live.hexlabs.org (only if used)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# public URL for QR codes (set to the Vercel URL after deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
