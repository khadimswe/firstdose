# Copy to .env and fill in. Never commit .env.

# data source for every screen: mock | supabase
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (Vinh): URL from Connect; keys from Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional direct/session-pooler connection for reviewed migrations; never public.
SUPABASE_DB_URL=

# Private shared demo access token (32+ random characters), separate from Supabase.
# CLI: Authorization: Bearer <token>. Browsers: enter once at /api/demo-login.
# The server issues a signed HttpOnly cookie. Never put the token in NEXT_PUBLIC_* or a URL.
FIRSTDOSE_DEMO_TOKEN=

# Tiger Data (plain pg driver) (Vihn)
TIGER_DATABASE_URL=

# Gemini API: note text -> reason enum only (Vihn)
GEMINI_API_KEY=
# Model id pinned by scripts/classifier/smoke.ts; never the key itself.
GEMINI_MODEL=

# xAI Grok STT (Vihn)
XAI_API_KEY=

# ElevenLabs (MLH code)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ntfy topic that the iPhone app subscribes to (Vihn)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional bearer token for a protected ntfy topic; server-side only.
NTFY_TOKEN=

# OpenAI via live.hexlabs.org (only if used)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# public URL for QR codes (set to the Vercel URL after deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
