  "k1-hook": {
    "duration": 18.0,
    "cues": [
      {
        "start": 0.0,
        "end": 2.06,
        "text": "DocUpdate published this headline:"
      },
      {
        "start": 2.06,
        "end": 3.42,
        "text": "“The prescription was sent."
      },
      {
        "start": 3.42,
        "end": 5.18,
        "text": "The patient still never started it.”"
      },
      {
        "start": 5.18,
        "end": 7.87,
        "text": "Surescripts says one in four new prescriptions"
      },
      {
        "start": 7.87,
        "end": 9.26,
        "text": "are never dispensed."
      },
      {
        "start": 9.26,
        "end": 11.88,
        "text": "And a patient who never started looks exactly"
      },
      {
        "start": 11.88,
        "end": 13.67,
        "text": "like a drug that doesn't work."
      },
      {
        "start": 13.67,
        "end": 16.22,
        "text": "The person who can fix it is someone Impiricus"
      },
      {
        "start": 16.22,
        "end": 18.0,
        "text": "has never reached."
      }
    ],
