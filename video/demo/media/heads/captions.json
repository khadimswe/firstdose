  "k3-close": {
    "duration": 22.4,
    "cues": [
      {
        "start": 0.19,
        "end": 5.19,
        "text": "About 467,000 medical assistants work in doctors' offices."
      },
      {
        "start": 5.19,
        "end": 7.87,
        "text": "None of Impiricus's products are built for them."
      },
      {
        "start": 7.87,
        "end": 8.95,
        "text": "FirstDose is."
      },
      {
        "start": 8.95,
        "end": 11.55,
        "text": "And it routes to fixes Impiricus already runs:"
      },
      {
        "start": 11.55,
        "end": 14.83,
        "text": "Wallet, Concierge, QPharma and Medvantx."
      },
      {
        "start": 14.83,
        "end": 18.09,
        "text": "Impiricus reaches the doctor who writes the prescription."
      },
      {
        "start": 18.09,
        "end": 20.59,
        "text": "FirstDose reaches the person who gets the"
      },
      {
        "start": 20.59,
        "end": 22.4,
        "text": "patient on it, every day."
      }
