  "k2-intro": {
    "duration": 16.0,
    "cues": [
      {
        "start": 0.0,
        "end": 1.99,
        "text": "So we created FirstDose."
      },
      {
        "start": 1.99,
        "end": 4.03,
        "text": "It's a new Ascend skill inside DocUpdate."
      },
      {
        "start": 4.03,
        "end": 7.03,
        "text": "Spark fires when the prescription is written."
      },
      {
        "start": 7.03,
        "end": 9.0,
        "text": "FirstDose fires when it isn't filled."
      },
      {
        "start": 9.0,
        "end": 11.43,
        "text": "It gives DocUpdate its first staff account,"
      },
      {
        "start": 11.43,
        "end": 14.2,
        "text": "and Market Access would pay per confirmed first"
      },
      {
        "start": 14.2,
        "end": 16.0,
        "text": "fill, never per prescription."
      }
    ],
