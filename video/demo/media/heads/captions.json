  "m-james": {
    "duration": 46.35,
    "cues": [
      {
        "start": 0.01,
        "end": 1.63,
        "text": "James is on Humira."
      },
      {
        "start": 1.63,
        "end": 6.41,
        "text": "His pharmacy note says prior authorization required,"
      },
      {
        "start": 6.41,
        "end": 10.85,
        "text": "and he couldn't be reached after three calls."
      },
      {
        "start": 10.85,
        "end": 15.36,
        "text": "Gemini reads that messy note and returns one reason code,"
      },
      {
        "start": 15.36,
        "end": 18.74,
        "text": "or unknown, which goes to a person."
      },
      {
        "start": 18.74,
        "end": 22.15,
        "text": "Then a rule, not AI, picks the fix:"
      },
      {
        "start": 22.15,
        "end": 25.18,
        "text": "connect to access support."
      },
      {
        "start": 25.18,
        "end": 30.18,
        "text": "No model writes drug or patient text."
      },
      {
        "start": 30.18,
        "end": 34.93,
        "text": "Every step lands in an event history on Tiger"
      },
      {
        "start": 34.93,
        "end": 39.08,
        "text": "Data, so the office sees confirmed first fills"
      },
      {
        "start": 39.08,
        "end": 41.28,
        "text": "and time to first fill."
      },
      {
        "start": 41.28,
        "end": 46.35,
        "text": "Pharma sees counts only, never a name."
      }
    ],
