  "v-maria": {
    "duration": 52.18,
    "cues": [
      {
        "start": 0.0,
        "end": 1.78,
        "text": "This is the coordinator's queue."
      },
      {
        "start": 1.78,
        "end": 4.82,
        "text": "She's the person who gets patients onto their medication,"
      },
      {
        "start": 4.82,
        "end": 6.74,
        "text": "and she opens this every morning."
      },
      {
        "start": 6.74,
        "end": 8.56,
        "text": "Maria is a fictional patient."
      },
      {
        "start": 8.56,
        "end": 11.55,
        "text": "Her doctor signs an Otezla prescription in DocUpdate,"
      },
      {
        "start": 11.55,
        "end": 13.92,
        "text": "with the label verbatim from DailyMed."
      },
      {
        "start": 13.92,
        "end": 15.92,
        "text": "Today, that's where the story ends."
      },
      {
        "start": 15.92,
        "end": 18.38,
        "text": "Here, the pharmacy reports it wasn't dispensed:"
      },
      {
        "start": 18.38,
        "end": 20.04,
        "text": "declined at the price."
      },
      {
        "start": 20.04,
        "end": 22.11,
        "text": "The doctor's watch buzzes with the reason."
      },
      {
        "start": 22.11,
        "end": 23.81,
        "text": "One tap: Send to my coordinator."
      },
      {
        "start": 23.81,
        "end": 26.69,
        "text": "The first time, the doctor approves their coordinator,"
      },
      {
        "start": 26.69,
        "end": 29.3,
        "text": "a staff account, the way CoverMyMeds does it,"
      },
      {
        "start": 29.3,
        "end": 31.14,
        "text": "inside the app they already use."
      },
      {
        "start": 31.14,
        "end": 33.84,
        "text": "Maria jumps to the top of the queue with one"
      },
      {
        "start": 33.84,
        "end": 36.46,
        "text": "fix: re-send the copay card."
      },
      {
        "start": 36.46,
        "end": 38.52,
        "text": "Maria opens her card on her phone"
      },
      {
        "start": 38.52,
        "end": 40.26,
        "text": "and taps Use at pharmacy."
      },
      {
        "start": 40.26,
        "end": 42.44,
        "text": "That's an acknowledgment, not a fill."
      },
      {
        "start": 42.44,
        "end": 44.02,
        "text": "The case stays pending."
      },
      {
        "start": 44.02,
        "end": 46.13,
        "text": "Only when the pharmacy confirms does"
      },
      {
        "start": 46.13,
        "end": 47.9,
        "text": "it say Fill confirmed."
      },
      {
        "start": 47.9,
        "end": 49.64,
        "text": "The doctor heard about it twice:"
      },
      {
        "start": 49.64,
        "end": 52.18,
        "text": "when it broke, and when it was fixed."
      }
    ],
